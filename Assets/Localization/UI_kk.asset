  - m_Id: 2420715636
    m_Localized: "\u04E8\u0428\u0406\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715637
    m_Localized: "<b>\u041E\u049B\u044B\u0442\u0443</b>: \u049B\u0430\u0434\u0430\u043C\u0434\u044B\u049B \u043A\u0435\u04A3\u0435\u0441\u0442\u0435\u0440 \u043C\u0435\u043D \u043E\u049B\u0443 \u0430\u043F\u0430\u0442\u0442\u0430\u0440\u044B.\n<b>\u0415\u043C\u0442\u0438\u0445\u0430\u043D</b>: \u043A\u0435\u04A3\u0435\u0441\u0442\u0435\u0440 \u0436\u043E\u049B, \u0430\u043F\u0430\u0442 \u043A\u0435\u043D\u0435\u0442\u0442\u0435\u043D \u0431\u0430\u0441\u0442\u0430\u043B\u0430\u0434\u044B, \u0441\u043E\u04A3\u044B\u043D\u0434\u0430 \u0431\u0430\u0493\u0430 \u049B\u043E\u0439\u044B\u043B\u0430\u0434\u044B.\n\u0415\u043A\u0456 \u0440\u0435\u0436\u0438\u043C \u0434\u0430 \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B \u0431\u0430\u043F\u0442\u0430\u0443\u043B\u0430\u0440\u044B\u043D \u049B\u0430\u043B\u043F\u044B\u043D\u0430 \u043A\u0435\u043B\u0442\u0456\u0440\u0456\u043F, \u0416\u049A\u049A \u0448\u0435\u0448\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715638
    m_Localized: "\u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0436\u04AF\u0440\u0456\u043F \u0436\u0430\u0442\u044B\u0440. \u0422\u0430\u043F\u0441\u044B\u0440\u043C\u0430 \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u0442\u0456\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0434\u0435 \u043A\u04E9\u0440\u0441\u0435\u0442\u0456\u043B\u0433\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715639
    m_Localized: "{0}-\u049B\u0430\u0434\u0430\u043C ({1} \u049B\u0430\u0434\u0430\u043C\u043D\u0430\u043D)."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715640
    m_Localized: "<color=#6FDC8C>\u0414\u0430\u0439\u044B\u043D</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715641
    m_Localized: "\u0421\u04D9\u0443\u043B\u0435\u043D\u0456 \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B\u04A3 \u043A\u0435\u0437 \u043A\u0435\u043B\u0433\u0435\u043D \u0442\u043E\u0440\u0430\u0431\u044B\u043D\u0430 \u0431\u0430\u0493\u044B\u0442\u0442\u0430\u04A3\u044B\u0437: \u0436\u0430\u049B\u0442\u0430\u0443 \u043F\u0430\u0439\u0434\u0430 \u0431\u043E\u043B\u0430\u0434\u044B. \u0421\u0438\u043F\u0430\u0442\u0442\u0430\u043C\u0430\u043D\u044B \u0430\u0448\u0443 \u04AF\u0448\u0456\u043D \u0448\u04AF\u0440\u0456\u043F\u043F\u0435\u043D\u0456 \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715642
    m_Localized: "\u0416\u049A\u049A \u0441\u04E9\u0440\u0435\u0441\u0456\u043D\u0435 \u0431\u0430\u0440\u044B\u04A3\u044B\u0437. \u041A\u0430\u0441\u043A\u0430, \u043A\u04E9\u0437\u0456\u043B\u0434\u0456\u0440\u0456\u043A \u043F\u0435\u043D \u0440\u0435\u0441\u043F\u0438\u0440\u0430\u0442\u043E\u0440\u0434\u044B \u049B\u043E\u043B\u0493\u0430 \u0430\u043B\u044B\u043F, \u0431\u0430\u0441\u049B\u0430 \u0436\u04D9\u043D\u0435 \u0431\u0435\u0442\u043A\u0435 \u0430\u043F\u0430\u0440\u044B\u04A3\u044B\u0437. \u049A\u043E\u043B\u0493\u0430\u043F\u0442\u044B \u0441\u04D9\u0443\u043B\u0435 \u043C\u0435\u043D \u0448\u04AF\u0440\u0456\u043F\u043F\u0435 \u0430\u0440\u049B\u044B\u043B\u044B \u043A\u0438\u0456\u04A3\u0456\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715643
    m_Localized: "\xAB\u0411\u0430\u0441\u049B\u0430\u0440\u0443\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B: \xAB\u0421\u043E\u0434\u0430\xBB \u0441\u04B1\u0439\u044B\u049B\u0442\u044B\u0493\u044B\u043D \u0442\u0430\u04A3\u0434\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715644
    m_Localized: "\u0421\u043E\u043B \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0434\u0430 \u0441\u043E\u0440\u0493\u044B\u043D\u044B 3-\u0434\u0435\u04A3\u0433\u0435\u0439\u0433\u0435 \u049B\u043E\u0439\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715645
    m_Localized: "\u049A\u043E\u043B\u043C\u0435\u043D \u0431\u0430\u0441\u049B\u0430\u0440\u0443 \u0431\u0435\u043A\u0435\u0442\u0456\u043D\u0435 \u0431\u0430\u0440\u044B\u043F, \u0432\u0435\u043D\u0442\u0438\u043B\u044C\u043C\u0435\u043D \u0441\u04B1\u0439\u044B\u049B\u0442\u044B\u049B \u0448\u044B\u0493\u044B\u043D\u044B\u043D 0,10 \u043C\xB3/\u0441 \u0435\u0442\u0456\u043F \u049B\u043E\u0439\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715646
    m_Localized: "\u0411\u0435\u043A\u0435\u0442\u0442\u0435\u0433\u0456 \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448\u043F\u0435\u043D \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715647
    m_Localized: "\u0422\u04AF\u0442\u0456\u043D\u0433\u0435 \u049B\u0430\u0440\u0430\u04A3\u044B\u0437: \u043A\u043E\u043B\u043E\u043D\u043D\u0430\u0434\u0430\u043D \u0448\u044B\u0493\u0430\u0440\u0434\u0430 \u043E\u043B \u0430\u0493\u0430\u0440\u0430\u0434\u044B. \u049A\u043E\u043D\u0434\u044B\u0440\u0493\u044B \u043A\u0435\u043C\u0456\u043D\u0434\u0435 {0} % \u0442\u0430\u0437\u0430\u0440\u0442\u0443\u043C\u0435\u043D \u0436\u04B1\u043C\u044B\u0441 \u0456\u0441\u0442\u0435\u0443\u0456 \u043A\u0435\u0440\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715648
    m_Localized: "\u041E\u049B\u0443 \u0430\u043F\u0430\u0442\u044B. \u041C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0434\u0456 \u0431\u0430\u049B\u044B\u043B\u0430\u04A3\u044B\u0437: \u049B\u044B\u0441\u044B\u043C \u04E9\u0441\u0456\u043F \u0436\u0430\u0442\u044B\u0440. \u0414\u0430\u0431\u044B\u043B \u0441\u0438\u0433\u043D\u0430\u043B\u044B\u043D \u043A\u04AF\u0442\u0456\u04A3\u0456\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715649
    m_Localized: "\u049A\u044B\u0441\u044B\u043C \u043D\u043E\u0440\u043C\u0430\u0434\u0430\u043D \u0436\u043E\u0493\u0430\u0440\u044B: \u0431\u04B1\u043B \u0431\u0456\u0442\u0435\u043B\u0443. \u049A\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u0442\u043E\u049B\u0442\u0430\u0442\u044B\u043F, \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448\u0442\u044B \u0431\u04B1\u0493\u0430\u0442\u0442\u0430\u04A3\u044B\u0437: \u0431\u0435\u043A\u0435\u0442\u0442\u0435\u0433\u0456 \u049B\u044B\u0437\u044B\u043B \u049B\u04B1\u043B\u044B\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715650
    m_Localized: "\xAB\u0410\u043F\u0430\u0442\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B: \xAB\u0422\u0430\u0437\u0430\u0440\u0442\u0443\xBB \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715651
    m_Localized: "\u0411\u04B1\u0493\u0430\u0442\u0442\u0430\u0443\u0434\u044B \u0430\u043B\u044B\u043F, \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u049B\u0430\u0439\u0442\u0430 \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715652
    m_Localized: "\u0416\u0430\u04A3\u0430 \u0430\u043F\u0430\u0442. \u0414\u0435\u04A3\u0433\u0435\u0439 \u04E9\u043B\u0448\u0435\u0433\u0456\u0448\u0442\u0456 \u0431\u0430\u049B\u044B\u043B\u0430\u04A3\u044B\u0437: \u0434\u0435\u04A3\u0433\u0435\u0439 \u0442\u04E9\u043C\u0435\u043D\u0434\u0435\u043F \u0436\u0430\u0442\u044B\u0440. \u0414\u0430\u0431\u044B\u043B \u0441\u0438\u0433\u043D\u0430\u043B\u044B\u043D \u043A\u04AF\u0442\u0456\u04A3\u0456\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715653
    m_Localized: "\u0414\u0435\u04A3\u0433\u0435\u0439 \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u043D\u0430\u043D \u0442\u04E9\u043C\u0435\u043D. \xAB\u0410\u043F\u0430\u0442\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B: \xAB\u049A\u04B1\u044E\xBB \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715654
    m_Localized: "\u049A\u04B1\u0439\u044B\u043B\u044B\u043F \u0436\u0430\u0442\u044B\u0440. \u041D\u043E\u0440\u043C\u0430\u043D\u044B \u043A\u04AF\u0442\u0456\u04A3\u0456\u0437; \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B \u0442\u043E\u049B\u0442\u0430\u043F \u0442\u04B1\u0440\u0441\u0430, \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715655
    m_Localized: "\u0421\u043E\u0440\u0493\u044B \u0430\u049B\u0430\u0443\u044B: \u043A\u043E\u043B\u043E\u043D\u043D\u0430\u0434\u0430\u0493\u044B \u0430\u0493\u044B\u043D\u0434\u0430\u0440 \u0436\u043E\u0493\u0430\u043B\u0434\u044B, \u0441\u043E\u0440\u0493\u044B \u0434\u044B\u0431\u044B\u0441\u044B \u0442\u044B\u043D\u0434\u044B, \u049B\u044B\u0441\u044B\u043C \u04E9\u0441\u0456\u043F \u0436\u0430\u0442\u044B\u0440. \u0422\u043E\u049B\u0442\u0430\u0442\u044B\u043F, \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448\u0442\u044B \u0431\u04B1\u0493\u0430\u0442\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715656
    m_Localized: "\xAB\u0410\u043F\u0430\u0442\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B: \xAB\u0421\u043E\u0440\u0493\u044B\u043D\u044B \u0436\u04E9\u043D\u0434\u0435\u0443\xBB \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715657
    m_Localized: "\u0422\u04AF\u0442\u0456\u043D \u0441\u043E\u0440\u0493\u044B\u0448 \u0430\u049B\u0430\u0443\u044B: \u0442\u04AF\u0442\u0456\u043D \u0436\u043E\u0493\u0430\u043B\u0434\u044B, \u0436\u0435\u043B\u0434\u0435\u0442\u043A\u0456\u0448 \u0434\u044B\u0431\u044B\u0441\u044B \u0442\u044B\u043D\u0434\u044B, \u049B\u044B\u0441\u044B\u043C \u04E9\u0441\u0456\u043F \u0436\u0430\u0442\u044B\u0440. \u0422\u043E\u049B\u0442\u0430\u0442\u044B\u043F, \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448\u0442\u044B \u0431\u04B1\u0493\u0430\u0442\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715658
    m_Localized: "\xAB\u0410\u043F\u0430\u0442\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B: \xAB\u0422\u04AF\u0442\u0456\u043D \u0441\u043E\u0440\u0493\u044B\u0448\u0442\u044B \u0436\u04E9\u043D\u0434\u0435\u0443\xBB \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715659
    m_Localized: "\u041C\u0430\u043D\u043E\u043C\u0435\u0442\u0440 \u04E9\u0441\u0443\u0434\u0456 \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0434\u0456, \u0431\u0456\u0440\u0430\u049B \u0441\u0438\u0440\u0435\u043D\u0430 \u0436\u043E\u049B, \u0430\u043B \xAB\u0410\u043F\u0430\u0442\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u0434\u0430\u0442\u0447\u0438\u043A \u049B\u0430\u043B\u044B\u043F\u0442\u044B. \u0410\u0441\u043F\u0430\u043F \u0430\u049B\u0430\u0443\u043B\u044B. \u0422\u043E\u049B\u0442\u0430\u0442\u044B\u043F, \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448\u0442\u044B \u0431\u04B1\u0493\u0430\u0442\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715660
    m_Localized: "\xAB\u0410\u043F\u0430\u0442\xBB \u049B\u043E\u0439\u044B\u043D\u0434\u044B\u0441\u044B: \xAB\u041C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0434\u0456 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0443\xBB \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715661
    m_Localized: "\u0415\u043C\u0442\u0438\u0445\u0430\u043D: \u049B\u0430\u0443\u0456\u043F\u0441\u0456\u0437\u0434\u0456\u043A \u0442\u04D9\u0440\u0442\u0456\u0431\u0456\u043D \u0441\u0430\u049B\u0442\u0430\u043F, \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u043A\u0435\u043C\u0456\u043D\u0434\u0435 {0} % \u0442\u0430\u0437\u0430\u0440\u0442\u0443\u043C\u0435\u043D \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437 \u0436\u04D9\u043D\u0435 \u0430\u0441\u043F\u0430\u043F\u0442\u0430\u0440\u0434\u044B \u0431\u0430\u049B\u044B\u043B\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715662
    m_Localized: "<b>\u041E\u049B\u044B\u0442\u0443 \u0430\u044F\u049B\u0442\u0430\u043B\u0434\u044B.</b>\n\u0415\u043D\u0434\u0456 \u0435\u043C\u0442\u0438\u0445\u0430\u043D \u0442\u0430\u043F\u0441\u044B\u0440\u0443\u0493\u0430 \u0431\u043E\u043B\u0430\u0434\u044B: \u043A\u0435\u04A3\u0435\u0441\u0442\u0435\u0440 \u0431\u043E\u043B\u043C\u0430\u0439\u0434\u044B, \u0430\u043F\u0430\u0442 \u0435\u0441\u043A\u0435\u0440\u0442\u0443\u0441\u0456\u0437 \u0431\u0430\u0441\u0442\u0430\u043B\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715663
    m_Localized: "<color=#FF5A4A><b>\u0416\u0430\u0440\u044B\u043B\u044B\u0441.</b></color> \u049A\u043E\u043D\u0434\u044B\u0440\u0493\u044B \u0436\u04B1\u043C\u044B\u0441 \u0456\u0441\u0442\u0435\u043F \u0442\u04B1\u0440\u0493\u0430\u043D\u0434\u0430 \u049B\u044B\u0441\u044B\u043C \u0436\u0430\u0440\u044B\u043B\u0443 \u0448\u0435\u0433\u0456\u043D\u0435 \u0436\u0435\u0442\u0442\u0456.\n\u041E\u049B\u044B\u0442\u0443\u0434\u044B \u049B\u0430\u0439\u0442\u0430 \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437: \u0434\u0430\u0431\u044B\u043B \u043A\u0435\u0437\u0456\u043D\u0434\u0435 \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u0431\u0456\u0440\u0434\u0435\u043D \u0442\u043E\u049B\u0442\u0430\u0442\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715664
    m_Localized: "<color=#6FDC8C><b>\u0415\u0441\u0435\u043F\u0442\u0435\u043B\u0434\u0456: 100-\u0434\u0435\u043D {0}</b></color>"
    m_Metadata:
      m_Items: []
