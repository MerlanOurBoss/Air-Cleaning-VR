      m_Items: []
  - m_Id: 2420715562
    m_Localized: "\u041E\u049B\u0443 \u0430\u043F\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715563
    m_Localized: "\u0416\u0430\u0431\u0434\u044B\u049B \u0430\u049B\u0430\u0443\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715564
    m_Localized: "\u041A\u0435\u0437\u0434\u0435\u0439\u0441\u043E\u049B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715565
    m_Localized: "\u0411\u0456\u0442\u0435\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715566
    m_Localized: "\u0414\u0435\u04A3\u0433\u0435\u0439\u0434\u0456\u04A3 \u0442\u04E9\u043C\u0435\u043D\u0434\u0435\u0443\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715567
    m_Localized: "\u0421\u043E\u0440\u0493\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715568
    m_Localized: "\u0422\u04AF\u0442\u0456\u043D \u0441\u043E\u0440\u0493\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715569
    m_Localized: "\u041C\u0430\u043D\u043E\u043C\u0435\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715570
    m_Localized: "\u0416\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715571
    m_Localized: "\u0422\u0430\u0437\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715572
    m_Localized: "\u049A\u04B1\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715573
    m_Localized: "\u0421\u043E\u0440\u0493\u044B\u043D\u044B \u0436\u04E9\u043D\u0434\u0435\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715574
    m_Localized: "\u0422\u04AF\u0442\u0456\u043D \u0441\u043E\u0440\u0493\u044B\u0448\u0442\u044B \u0436\u04E9\u043D\u0434\u0435\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715575
    m_Localized: "\u041C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0434\u0456 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715576
    m_Localized: "\u049A\u043E\u043D\u0434\u044B\u0440\u0493\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715577
    m_Localized: "\u049A\u0430\u043B\u043F\u044B\u043D\u0430 \u043A\u0435\u043B\u0442\u0456\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715578
    m_Localized: "\u0415\u0440\u0435\u0436\u0435\u043B\u0435\u0440: \u049B\u043E\u0441\u0443\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715579
    m_Localized: "\u0415\u0440\u0435\u0436\u0435\u043B\u0435\u0440: \u04E9\u0448\u0456\u0440\u0443\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715580
    m_Localized: "\u049A\u044B\u0441\u044B\u043C \u0434\u0430\u0442\u0447\u0438\u0433\u0456 {0} \u043A\u041F\u0430  \xB7  \u0414\u0435\u04A3\u0433\u0435\u0439 {1} %  \xB7  \u0416\u049A\u049A {2}/{3}"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715581
    m_Localized: "<color=#FF5A4A>\u0414\u0410\u0411\u042B\u041B: \u049B\u044B\u0441\u044B\u043C \u0436\u043E\u0493\u0430\u0440\u044B</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715582
    m_Localized: "<color=#FF5A4A>\u0414\u0410\u0411\u042B\u041B: \u0434\u0435\u04A3\u0433\u0435\u0439 \u0442\u04E9\u043C\u0435\u043D</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715583
    m_Localized: "<color=#FF5A4A>\u0416\u0410\u0420\u042B\u041B\u042B\u0421. \u0421\u0435\u0431\u0435\u0431\u0456: {0}.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715584
    m_Localized: "\u0431\u0456\u0442\u0435\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715585
    m_Localized: "\u0442\u04E9\u043C\u0435\u043D \u0434\u0435\u04A3\u0433\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715586
    m_Localized: "\u0441\u043E\u0440\u0493\u044B \u0430\u049B\u0430\u0443\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715587
    m_Localized: "\u0442\u04AF\u0442\u0456\u043D \u0441\u043E\u0440\u0493\u044B\u0448 \u0430\u049B\u0430\u0443\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715588
    m_Localized: "\u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440 \u0430\u049B\u0430\u0443\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715589
    m_Localized: "\u0410\u043F\u0430\u0442 \u0431\u0456\u0440 \u043C\u0438\u043D\u0443\u0442 \u0456\u0448\u0456\u043D\u0434\u0435 \u0431\u043E\u043B\u0430\u0434\u044B. \u0410\u0441\u043F\u0430\u043F\u0442\u0430\u0440\u0434\u044B \u0431\u0430\u049B\u044B\u043B\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715590
    m_Localized: "\u041E\u049B\u0443 \u0430\u043F\u0430\u0442\u044B: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715591
    m_Localized: "\u049A\u043E\u043D\u0434\u044B\u0440\u0493\u044B \u049B\u0430\u043B\u043F\u044B\u043D\u0430 \u043A\u0435\u043B\u0442\u0456\u0440\u0456\u043B\u0434\u0456. \u041E\u043D\u044B \xAB\u0411\u0430\u0441\u049B\u0430\u0440\u0443\xBB \u0431\u0435\u0442\u0456\u043D\u0434\u0435 \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715592
    m_Localized: "\u041C\u04B1\u043D\u0434\u0430\u0439 \u0430\u049B\u0430\u0443 \u0436\u043E\u049B."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715593
    m_Localized: "\u0410\u043B\u0434\u044B\u043C\u0435\u043D \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u0442\u043E\u049B\u0442\u0430\u0442\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715594
    m_Localized: "\u0410\u043B\u0434\u044B\u043C\u0435\u043D \u0431\u0430\u0441\u049B\u0430\u0440\u0443 \u0431\u0435\u043A\u0435\u0442\u0456\u043D\u0434\u0435\u0433\u0456 \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448\u0442\u044B \u0431\u04B1\u0493\u0430\u0442\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715595
    m_Localized: "\u0410\u043B\u0434\u044B\u043C\u0435\u043D \u0441\u04E9\u0440\u0435\u0434\u0435\u0433\u0456 \u0416\u049A\u049A \u043A\u0438\u0456\u04A3\u0456\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715596
    m_Localized: "\u0410\u049B\u0430\u0443 \u0436\u043E\u0439\u044B\u043B\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715597
    m_Localized: "\u0411\u04B1\u0493\u0430\u0442\u0442\u0430\u0443\u0434\u044B \u0430\u043B\u044B\u043F, \u049B\u043E\u043D\u0434\u044B\u0440\u0493\u044B\u043D\u044B \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715598
    m_Localized: "\u049A\u04B1\u0439\u044B\u043B\u044B\u043F \u0436\u0430\u0442\u044B\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715599
    m_Localized: "\u0411\u0430\u043F\u0442\u0430\u0443\u0434\u044B \u0442\u04AF\u0437\u0435\u0442\u0456\u04A3\u0456\u0437. {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715600
    m_Localized: "5 \xB0C \u043A\u0435\u0437\u0456\u043D\u0434\u0435\u0433\u0456 \u0441\u043E\u0434\u0430: \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0434\u0430\u043D\u0443, \u0431\u0456\u0442\u0435\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715601
    m_Localized: "\u0413\u0430\u0437 14 \u043C\xB3/\u0441, \u0441\u04B1\u0439\u044B\u049B\u0442\u044B\u049B 0,01 \u043C\xB3/\u0441: \u0441\u0443\u0430\u0440\u0443 \u0430\u0437, \u0448\u04E9\u0433\u0456\u043D\u0434\u0456\u043B\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715602
    m_Localized: "1-\u0441\u043E\u0440\u0493\u044B, \u0441\u04B1\u0439\u044B\u049B\u0442\u044B\u049B 0,1 \u043C\xB3/\u0441: \u0441\u043E\u0440\u0493\u044B \u04AF\u043B\u0433\u0435\u0440\u043C\u0435\u0439\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715603
