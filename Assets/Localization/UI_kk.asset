  - m_Id: 2420715631
    m_Localized: "\u049A\u0410\u0423\u0406\u041F\u0422\u0406 \u0410\u0419\u041C\u0410\u049A\n\u0422\u0435\u043A \u0416\u049A\u049A-\u043C\u0435\u043D \u043A\u0456\u0440\u0443\u0433\u0435 \u0431\u043E\u043B\u0430\u0434\u044B"
