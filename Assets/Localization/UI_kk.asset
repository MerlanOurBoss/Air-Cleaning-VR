  - m_Id: 2420715617
    m_Localized: "\u041A\u043E\u043B\u043E\u043D\u043D\u0430\u0434\u0430\u0493\u044B \u049B\u044B\u0441\u044B\u043C. \u041D\u043E\u0440\u043C\u0430 2,5 \u043A\u041F\u0430, \u049B\u044B\u0437\u044B\u043B \u0430\u0439\u043C\u0430\u049B 6 \u043A\u041F\u0430-\u0434\u0430\u043D, 10 \u043A\u041F\u0430 \u043A\u0435\u0437\u0456\u043D\u0434\u0435 \u043A\u043E\u043B\u043E\u043D\u043D\u0430 \u0436\u0430\u0440\u044B\u043B\u0430\u0434\u044B."
