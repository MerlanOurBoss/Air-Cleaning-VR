    m_Metadata:
      m_Items: []
  - m_Id: 2420715536
    m_Localized: "\u0416\u04B1\u043C\u044B\u0441 \u0456\u0441\u0442\u0435\u043F \u0442\u04B1\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715537
    m_Localized: "\u0422\u043E\u049B\u0442\u0430\u0442\u044B\u043B\u0493\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715538
    m_Localized: "{0}  \xB7  \u0441\u043E\u0440\u0493\u044B {1}  \xB7  {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715539
    m_Localized: "  \xB7  \u0442\u0430\u0437\u0430\u0440\u0442\u0443 {0} %"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715540
    m_Localized: "  \xB7  \u0430\u0436\u044B\u0440\u0430\u0442\u049B\u044B\u0448 \u0431\u04B1\u0493\u0430\u0442\u0442\u0430\u043B\u0493\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715541
    m_Localized: "\u049A\u043E\u043D\u0434\u044B\u0440\u0493\u044B \u0433\u0430\u0437\u044B, \u043C\xB3/\u0441\u0430\u0493"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715542
    m_Localized: "\u0413\u0430\u0437 \u0448\u044B\u0493\u044B\u043D\u044B, \u043C\xB3/\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715543
    m_Localized: "\u0421\u04B1\u0439\u044B\u049B\u0442\u044B\u049B \u0448\u044B\u0493\u044B\u043D\u044B, \u043C\xB3/\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715544
    m_Localized: "\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430, \xB0C"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715545
    m_Localized: "\u041F\u0430\u0432\u043B\u043E\u0434\u0430\u0440 \u0416\u042D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715546
    m_Localized: "\u0410\u043B\u043C\u0430\u0442\u044B \u0416\u042D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715547
    m_Localized: "\u0413\u0430\u0437 \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u0493\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715548
    m_Localized: "\u0421\u0443 \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u0493\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715549
    m_Localized: "\u0413\u0430\u0437\u0434\u044B\u04A3 \u043C\u0430\u0441\u0441\u0430\u043B\u044B\u049B \u0430\u0493\u044B\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715550
    m_Localized: "\u0421\u04B1\u0439\u044B\u049B. \u043C\u0430\u0441\u0441\u0430\u043B\u044B\u049B \u0430\u0493\u044B\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715551
    m_Localized: "\u041C\u0430\u0441\u0441\u0430 \u0430\u043B\u043C\u0430\u0441\u0443 \u043A\u043E\u044D\u0444."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715552
    m_Localized: "\u0421\u04B1\u0439\u044B\u049B\u0442\u044B\u049B \u0448\u044B\u0493\u044B\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715553
    m_Localized: "\u0410\u043F\u043F\u0430\u0440\u0430\u0442 \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715554
    m_Localized: "\u0410\u043F\u043F\u0430\u0440\u0430\u0442 \u0431\u0438\u0456\u043A\u0442\u0456\u0433\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715555
    m_Localized: "\u0428\u044B\u0493\u044B\u043D \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0434\u0430\u0440\u044B"
