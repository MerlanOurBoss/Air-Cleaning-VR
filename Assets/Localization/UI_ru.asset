      m_Items: []
  - m_Id: 2420715640
    m_Localized: "<color=#6FDC8C>\u0413\u043E\u0442\u043E\u0432\u043E</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715641
    m_Localized: "\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043B\u0443\u0447 \u043D\u0430 \u043B\u044E\u0431\u043E\u0439 \u0443\u0437\u0435\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438: \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0440\u0430\u043C\u043A\u0430. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u0443\u0440\u043E\u043A, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715642
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u0439\u043A\u0435 \u0421\u0418\u0417. \u041A\u0430\u0441\u043A\u0443, \u043E\u0447\u043A\u0438 \u0438 \u0440\u0435\u0441\u043F\u0438\u0440\u0430\u0442\u043E\u0440 \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0445\u0432\u0430\u0442\u043E\u043C \u0438 \u043F\u043E\u0434\u043D\u0435\u0441\u0438\u0442\u0435 \u043A \u0433\u043E\u043B\u043E\u0432\u0435 \u0438 \u043B\u0438\u0446\u0443. \u041F\u0435\u0440\u0447\u0430\u0442\u043A\u0438 \u043D\u0430\u0434\u0435\u043D\u044C\u0442\u0435 \u043B\u0443\u0447\u043E\u043C \u0438 \u043A\u0443\u0440\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715643
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0430 \xAB\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\xBB: \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C \xAB\u0421\u043E\u0434\u0430\xBB."
