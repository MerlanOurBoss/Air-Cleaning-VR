    m_Localized: "\u0412\u042B\u041A\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715637
    m_Localized: "<b>\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435</b>: \u043F\u043E\u0448\u0430\u0433\u043E\u0432\u044B\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0438 \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0430\u0432\u0430\u0440\u0438\u0438.\n<b>\u042D\u043A\u0437\u0430\u043C\u0435\u043D</b>: \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A \u043D\u0435\u0442, \u0430\u0432\u0430\u0440\u0438\u044F \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E, \u0432 \u043A\u043E\u043D\u0446\u0435 \u0431\u0443\u0434\u0435\u0442 \u043E\u0446\u0435\u043D\u043A\u0430.\n\u041E\u0431\u0430 \u0440\u0435\u0436\u0438\u043C\u0430 \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0438 \u0441\u043D\u0438\u043C\u0430\u044E\u0442 \u0421\u0418\u0417."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715638
    m_Localized: "\u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0438\u0434\u0451\u0442. \u0417\u0430\u0434\u0430\u0447\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0430 \u043D\u0430\u0434 \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715639
    m_Localized: "\u0428\u0430\u0433 {0} \u0438\u0437 {1}."
