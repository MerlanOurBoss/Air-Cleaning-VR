  - m_Id: 2420715573
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u043D\u0430\u0441\u043E\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715574
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0434\u044B\u043C\u043E\u0441\u043E\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715575
    m_Localized: "\u0417\u0430\u043C\u0435\u043D\u0430 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715576
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715577
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715578
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430: \u0432\u043A\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715579
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430: \u0432\u044B\u043A\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715580
    m_Localized: "\u0414\u0430\u0442\u0447\u0438\u043A \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F {0} \u043A\u041F\u0430  \xB7  \u0423\u0440\u043E\u0432\u0435\u043D\u044C {1} %  \xB7  \u0421\u0418\u0417 {2} \u0438\u0437 {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715581
    m_Localized: "<color=#FF5A4A>\u0422\u0420\u0415\u0412\u041E\u0413\u0410: \u0432\u044B\u0441\u043E\u043A\u043E\u0435 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715582
    m_Localized: "<color=#FF5A4A>\u0422\u0420\u0415\u0412\u041E\u0413\u0410: \u043D\u0438\u0437\u043A\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715583
    m_Localized: "<color=#FF5A4A>\u0412\u0417\u0420\u042B\u0412. \u041F\u0440\u0438\u0447\u0438\u043D\u0430: {0}.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715584
    m_Localized: "\u0437\u0430\u0441\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715585
    m_Localized: "\u043D\u0438\u0437\u043A\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715586
    m_Localized: "\u043E\u0442\u043A\u0430\u0437 \u043D\u0430\u0441\u043E\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715587
    m_Localized: "\u043E\u0442\u043A\u0430\u0437 \u0434\u044B\u043C\u043E\u0441\u043E\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715588
    m_Localized: "\u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B\u0439 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715589
    m_Localized: "\u0410\u0432\u0430\u0440\u0438\u044F \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043C\u0438\u043D\u0443\u0442\u044B. \u0421\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715590
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u0430\u044F \u0430\u0432\u0430\u0440\u0438\u044F: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715591
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430. \u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0435\u0451 \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \xAB\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715592
    m_Localized: "\u042D\u0442\u043E\u0439 \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715593
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715594
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A \u043D\u0430 \u043F\u043E\u0441\u0442\u0443 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715595
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u0435\u043D\u044C\u0442\u0435 \u0421\u0418\u0417 \u0441\u043E \u0441\u0442\u043E\u0439\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715596
    m_Localized: "\u041D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715597
    m_Localized: "\u0421\u043D\u0438\u043C\u0438\u0442\u0435 \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0443 \u0438 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715598
    m_Localized: "\u0418\u0434\u0451\u0442 \u0434\u043E\u043B\u0438\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715599
    m_Localized: "\u0418\u0441\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0443. {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715600
    m_Localized: "\u0421\u043E\u0434\u0430 \u043F\u0440\u0438 5 \xB0C: \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0438\u0437\u0430\u0446\u0438\u044F, \u0437\u0430\u0441\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715601
    m_Localized: "\u0413\u0430\u0437 14 \u043C\xB3/\u0441 \u043F\u0440\u0438 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438 0,01 \u043C\xB3/\u0441: \u043C\u0430\u043B\u043E \u043E\u0440\u043E\u0448\u0435\u043D\u0438\u044F, \u043E\u0442\u043B\u043E\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2420715602
