      m_Items: []
  - m_Id: 2420715648
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u0430\u044F \u0430\u0432\u0430\u0440\u0438\u044F. \u0421\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u043E\u043C: \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0442\u0451\u0442. \u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0441\u0438\u0433\u043D\u0430\u043B\u0430 \u0442\u0440\u0435\u0432\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715649
    m_Localized: "\u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u044B\u0448\u0435 \u043D\u043E\u0440\u043C\u044B: \u044D\u0442\u043E \u0437\u0430\u0441\u043E\u0440. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A: \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0437\u0430\u043C\u043E\u043A \u043D\u0430 \u043F\u043E\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715650
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0430 \xAB\u0410\u0432\u0430\u0440\u0438\u044F\xBB: \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u0440\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715651
    m_Localized: "\u0421\u043D\u0438\u043C\u0438\u0442\u0435 \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0443 \u0438 \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715652
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0430\u0432\u0430\u0440\u0438\u044F. \u0421\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0443\u0440\u043E\u0432\u043D\u0435\u043C\u0435\u0440\u043E\u043C: \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0430\u0434\u0430\u0435\u0442. \u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0441\u0438\u0433\u043D\u0430\u043B\u0430 \u0442\u0440\u0435\u0432\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715653
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0438\u0436\u0435 \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u0430. \u0412\u043A\u043B\u0430\u0434\u043A\u0430 \xAB\u0410\u0432\u0430\u0440\u0438\u044F\xBB: \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0414\u043E\u043B\u0438\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715654
    m_Localized: "\u0418\u0434\u0451\u0442 \u0434\u043E\u043B\u0438\u0432\u043A\u0430. \u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u043E\u0440\u043C\u044B; \u0435\u0441\u043B\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430, \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715655
    m_Localized: "\u041E\u0442\u043A\u0430\u0437 \u043D\u0430\u0441\u043E\u0441\u0430: \u0441\u0442\u0440\u0443\u0438 \u0432 \u043A\u043E\u043B\u043E\u043D\u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u043B\u0438, \u0437\u0432\u0443\u043A \u043D\u0430\u0441\u043E\u0441\u0430 \u0441\u0442\u0438\u0445, \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0442\u0451\u0442. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715656
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0430 \xAB\u0410\u0432\u0430\u0440\u0438\u044F\xBB: \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0420\u0435\u043C\u043E\u043D\u0442 \u043D\u0430\u0441\u043E\u0441\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715657
    m_Localized: "\u041E\u0442\u043A\u0430\u0437 \u0434\u044B\u043C\u043E\u0441\u043E\u0441\u0430: \u0434\u044B\u043C \u043F\u0440\u043E\u043F\u0430\u043B, \u0433\u0443\u043B \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440\u0430 \u0441\u0442\u0438\u0445, \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0442\u0451\u0442. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715658
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0430 \xAB\u0410\u0432\u0430\u0440\u0438\u044F\xBB: \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0420\u0435\u043C\u043E\u043D\u0442 \u0434\u044B\u043C\u043E\u0441\u043E\u0441\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715659
    m_Localized: "\u041C\u0430\u043D\u043E\u043C\u0435\u0442\u0440 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0440\u043E\u0441\u0442, \u043D\u043E \u0441\u0438\u0440\u0435\u043D\u044B \u043D\u0435\u0442, \u0430 \u0434\u0430\u0442\u0447\u0438\u043A \u043D\u0430 \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0410\u0432\u0430\u0440\u0438\u044F\xBB \u0432 \u043D\u043E\u0440\u043C\u0435. \u041F\u0440\u0438\u0431\u043E\u0440 \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u0435\u043D. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715660
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0430 \xAB\u0410\u0432\u0430\u0440\u0438\u044F\xBB: \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0417\u0430\u043C\u0435\u043D\u0430 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715661
    m_Localized: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D: \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u044F \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438, \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0441 \u043E\u0447\u0438\u0441\u0442\u043A\u043E\u0439 \u043D\u0435 \u043D\u0438\u0436\u0435 {0} % \u0438 \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715662
    m_Localized: "<b>\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E.</b>\n\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0430\u0442\u044C \u044D\u043A\u0437\u0430\u043C\u0435\u043D: \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A \u043D\u0435 \u0431\u0443\u0434\u0435\u0442, \u0430\u0432\u0430\u0440\u0438\u044F \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715663
    m_Localized: "<color=#FF5A4A><b>\u0412\u0437\u0440\u044B\u0432.</b></color> \u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u043E\u0448\u043B\u043E \u0434\u043E \u0440\u0430\u0437\u0440\u044B\u0432\u0430, \u043F\u043E\u043A\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430.\n\u041D\u0430\u0447\u043D\u0438\u0442\u0435 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0437\u0430\u043D\u043E\u0432\u043E: \u043F\u0440\u0438 \u0442\u0440\u0435\u0432\u043E\u0433\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0442\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2420715664
